# Paperclip para o EasyPanel: imagem oficial + tradução pt-BR.
#
# Não compila nada. Parte da imagem oficial publicada pelo Paperclip e só injeta o
# tradutor (deploy/easypanel/ptbr.js) no index.html da interface. O build leva poucos minutos.
#
# A imagem é fixada por digest para o EasyPanel sempre baixar a versão escolhida.
# Para atualizar o Paperclip: scripts/ptbr/bump-image.sh [nightly|latest|beta|canary]
FROM ghcr.io/paperclipai/paperclip:canary@sha256:01433fba98b6e4481babf4a07e951846b81bfc05f9dd90409aee8056b6a4e5bf

COPY --chown=node:node deploy/easypanel/ptbr.js /app/ui/dist/ptbr.js
RUN sed -i 's#<head>#<head><script defer src="/ptbr.js"></script>#' /app/ui/dist/index.html \
  && grep -q '/ptbr.js' /app/ui/dist/index.html
